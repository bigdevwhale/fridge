    <!-- Pairing -->
    <string name="pair_title">Pair the phones</string>
    <string name="pair_how">One phone shows a code, the other scans it. That\'s all, and only once. After that the two phones compare doors on their own whenever they\'re on the same Wi-Fi: at home.</string>
    <string name="pair_show">Show my code</string>
    <string name="pair_scan">Scan their code</string>
    <string name="pair_privacy">No account and no server. The code holds a key only your two phones know; everything between them is encrypted with it.</string>
    <string name="pair_already">This phone is paired with %1$s. Pairing again replaces it.</string>
    <string name="pair_bad">That isn\'t a fridge code. Try once more.</string>
    <string name="pair_show_how">Point the other phone\'s camera here.</string>
    <string name="pair_qr">The pairing code</string>
    <string name="pair_wifi">Once scanned, the two phones find each other on the same Wi-Fi.</string>
    <string name="pair_scanned">Paired with %1$s</string>
    <string name="pair_met">%1$s is here</string>
    <string name="pair_after">From now on the door is shared. New things travel whenever both phones are at home on the same Wi-Fi, and right away while the app is open on both.</string>
    <string name="pair_show_again">Show the code again</string>
    <string name="to_door">To the door</string>

