    <string name="about">About</string>
    <string name="about_text">A fridge door for two. No account, no cloud, no ads, no analytics: the two phones talk to each other directly, on your own Wi-Fi, encrypted with a key that never leaves them.</string>

    <!-- Welcome -->
    <string name="welcome_title">A fridge for two</string>
    <string name="welcome_1">The shopping list, whose turn it is, notes, asks without words, worries and confessions, all on one door.</string>
    <string name="welcome_2">The phones are paired once with a QR code, then compare doors on their own whenever you\'re both at home. No server, no account.</string>
    <string name="welcome_3">Some things open only together.</string>
    <string name="welcome_name">Your name</string>
    <string name="welcome_name_hint">to sign notes with</string>
    <string name="welcome_go">Hang the door</string>

